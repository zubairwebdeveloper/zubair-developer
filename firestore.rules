rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: sab kuch band.
    match /{document=**} {
      allow read, write: if false;
    }

    // Public, read-only, sirf published content.
    match /services/{id} {
      allow read: if resource.data.status == 'published';
    }
    match /pricingPlans/{id} {
      allow read: if resource.data.status == 'published';
    }
    match /projects/{id} {
      allow read: if resource.data.status == 'published';
    }
    match /faqs/{id} {
      allow read: if resource.data.status == 'published';
    }
        match /blogPosts/{id} {
      allow read: if resource.data.status == 'published';
    }
    match /testimonials/{id} {
      allow read: if resource.data.status == 'published';
    }
    match /skills/{id} {
      allow read: if resource.data.status == 'published';
    }
    match /experience/{id} {
      allow read: if resource.data.status == 'published';
    }

    // Public site settings (announcement, process steps). Private settings alag document ma rahengi.
    match /siteSettings/public {
      allow read: if true;
    }
    
  }
}